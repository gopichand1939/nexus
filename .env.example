# Generate a private .env with python3 scripts/setup.py. Never commit it.
APP_ORIGIN=http://localhost:8080
NODE_ENV=development
PORT=3000
TRUST_PROXY=1
DATABASE_URL=postgresql://nexus_app:REPLACE@postgres:5432/nexus_app
# Matrix handles realtime synchronization. No second Node pool is required.
REALTIME_DATABASE_URL=postgresql://nexus_app:REPLACE@postgres:5432/nexus_app
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
POSTGRES_ADMIN_PASSWORD=REPLACE
NEXUS_DB_PASSWORD=REPLACE
MATRIX_DB_PASSWORD=REPLACE
MATRIX_INTERNAL_URL=http://synapse:8008
MATRIX_SERVER_NAME=localhost
MATRIX_REGISTRATION_SECRET=REPLACE
MATRIX_SERVICE_USERNAME=nexus_service
MATRIX_SERVICE_PASSWORD=REPLACE
ADMIN_USERNAME=owner
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
ADMIN_TOTP_SECRET=REPLACE_WITH_BASE32_SECRET
REGISTRATION_OPEN=true
TURN_SECRET=REPLACE
TURN_HOST=localhost
TURN_EXTERNAL_IP=
NEXUS_DOMAIN=localhost

EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NEXUS <noreply@example.com>
